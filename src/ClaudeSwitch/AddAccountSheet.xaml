<UserControl x:Class="ClaudeSwitch.AddAccountSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClaudeSwitch"
             xmlns:ctl="clr-namespace:ClaudeSwitch.Controls"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Focusable="True" FocusVisualStyle="{x:Null}"
             Visibility="Collapsed">

    <UserControl.Resources>
        <Style x:Key="SheetTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource Text}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SheetBody" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="Centered" TargetType="TextBlock" BasedOn="{StaticResource SheetBody}">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- The page behind stays in view, dimmed, so it's clear this is a step, not a new place. -->
        <Border x:Name="Backdrop" Background="{DynamicResource Overlay}" Opacity="0"
                MouseLeftButtonDown="Backdrop_MouseDown"/>

        <Grid x:Name="SheetHost" VerticalAlignment="Bottom" Margin="12,0,12,12" MaxWidth="440" Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="SheetShift" Y="40"/>
            </Grid.RenderTransform>

            <!-- The shadow is its own empty layer: an Effect switches ClearType off for everything
                 inside it, and the sheet is mostly text. -->
            <Border CornerRadius="18" Background="{DynamicResource Raised}" Margin="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.3"
                                      Color="{DynamicResource ShadowColor}"/>
                </Border.Effect>
            </Border>

            <Border x:Name="Sheet" CornerRadius="18" Background="{DynamicResource Raised}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    Padding="20,18,20,16" ClipToBounds="True">
                <Grid>

                    <!-- ═══════════ 1 · How should the sign-in page open? ═══════════ -->
                    <StackPanel x:Name="ChoosePage">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="42" Height="42" CornerRadius="13" VerticalAlignment="Top"
                                    Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="ChooseIcon" Style="{StaticResource Glyph}" Text="&#xE8FA;"
                                           FontSize="18" Foreground="{DynamicResource Accent}"/>
                            </Border>

                            <StackPanel Grid.Column="1" Margin="13,1,8,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ChooseTitle" Style="{StaticResource SheetTitle}"/>
                                <TextBlock x:Name="ChooseBody" Style="{StaticResource SheetBody}"
                                           FontSize="{StaticResource FontSmall}" LineHeight="16"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;"
                                    FontSize="11" Width="30" Height="30" VerticalAlignment="Top" AutomationProperties.Name="{loc:Tr add.close}"
                                    Margin="0,-4,-8,0" Click="Close_Click"/>
                        </Grid>

                        <Button x:Name="BrowserOption" Style="{StaticResource OptionCard}" Margin="0,18,0,0" AutomationProperties.Name="{loc:Tr add.browser}"
                                Click="BrowserOption_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="11"
                                        Background="{DynamicResource AccentSoft}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="16"
                                               Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr add.browser}" FontSize="{StaticResource FontStrong}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:Tr add.browserDesc}" FontSize="{StaticResource FontSmall}"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="CopyOption" Style="{StaticResource OptionCard}" Margin="0,8,0,0" AutomationProperties.Name="{loc:Tr add.copy}"
                                Click="CopyOption_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="11"
                                        Background="{DynamicResource AccentSoft}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE71B;" FontSize="16"
                                               Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr add.copy}" FontSize="{StaticResource FontStrong}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{loc:Tr add.copyDesc}" FontSize="{StaticResource FontSmall}"
                                               Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Border Margin="0,14,0,0" Padding="11,9" CornerRadius="10"
                                Background="{DynamicResource Surface}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="12.5"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Top" Margin="0,2,9,0"/>
                                <TextBlock Grid.Column="1" Text="{loc:Tr add.note}"
                                           FontSize="{StaticResource FontSmall}" LineHeight="16"
                                           Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="RememberBox" Style="{StaticResource CheckStyle}"
                                  Content="{loc:Tr add.remember}" Margin="3,14,0,2"
                                  HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- ═══════════ 2 · Starting Claude Code's login ═══════════ -->
                    <StackPanel x:Name="PreparingPage" Visibility="Collapsed" Margin="0,8,0,0">
                        <ctl:Spinner Width="38" Height="38" Thickness="3" HorizontalAlignment="Center"
                                     Stroke="{DynamicResource Accent}" Track="{DynamicResource SurfaceHi}"/>
                        <TextBlock Text="{loc:Tr add.preparing}" Style="{StaticResource SheetTitle}"
                                   FontSize="{StaticResource FontStrong}" HorizontalAlignment="Center"
                                   Margin="0,16,0,0"/>
                        <Button Style="{StaticResource TextButton}" Content="{loc:Tr add.cancel}"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Click="Close_Click"/>
                    </StackPanel>

                    <!-- ═══════════ 3 · Waiting for the browser ═══════════ -->
                    <StackPanel x:Name="WaitingPage" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid Width="78" Height="78" HorizontalAlignment="Center">
                            <!-- A slow radar ping behind the icon: alive, not busy. -->
                            <Ellipse x:Name="Ping" Width="52" Height="52" Fill="{DynamicResource Accent}"
                                     Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="PingScale"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <ctl:Spinner Width="64" Height="64" Thickness="2.4"
                                         Stroke="{DynamicResource Accent}" Track="{DynamicResource Border}"/>
                            <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSoft}">
                                <TextBlock x:Name="WaitingIcon" Style="{StaticResource Glyph}" Text="&#xE774;"
                                           FontSize="19" Foreground="{DynamicResource Accent}"/>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="WaitingTitle" Text="{loc:Tr add.waitingTitle}"
                                   Style="{StaticResource SheetTitle}" HorizontalAlignment="Center"
                                   TextAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="WaitingBody" Style="{StaticResource Centered}"
                                   Margin="10,5,10,0" MaxWidth="330"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button x:Name="CopyLinkButton" Style="{StaticResource GhostButton}"
                                    Padding="12,7" FontSize="{StaticResource FontSmall}" Click="CopyLink_Click" AutomationProperties.Name="{loc:Tr add.copyLink}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="CopyLinkIcon" Style="{StaticResource Glyph}" Text="&#xE8C8;"
                                               FontSize="12" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="CopyLinkText"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="OpenBrowserButton" Style="{StaticResource GhostButton}"
                                    Padding="12,7" Margin="8,0,0,0" FontSize="{StaticResource FontSmall}"
                                    Click="OpenBrowser_Click" AutomationProperties.Name="{loc:Tr add.openBrowser}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A7;"
                                               FontSize="12" Margin="0,0,7,0"/>
                                    <TextBlock Text="{loc:Tr add.openBrowser}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Only when the page will end on a code: an old Claude Code that ignored the
                             browser handoff, so the printed, paste-back link is all there is. -->
                        <StackPanel x:Name="CodeRow" Visibility="Collapsed" Margin="0,16,0,0">
                            <TextBlock Text="{loc:Tr add.codeHint}" FontSize="{StaticResource FontSmall}"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CodeBox" Style="{StaticResource Field}"
                                         FontSize="{StaticResource FontBody}" KeyDown="CodeBox_KeyDown"/>
                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0"
                                        Padding="14,8" Content="{loc:Tr add.codeSubmit}" Click="SubmitCode_Click"/>
                            </Grid>
                        </StackPanel>

                        <Button Style="{StaticResource TextButton}" Content="{loc:Tr add.cancel}"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Click="Close_Click"/>
                    </StackPanel>

                    <!-- ═══════════ 4 · Done ═══════════ -->
                    <StackPanel x:Name="SuccessPage" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid x:Name="SuccessBadge" Width="66" Height="66" HorizontalAlignment="Center">
                            <Ellipse x:Name="SuccessDisc" Fill="{DynamicResource SuccessSoft}"/>
                            <Path x:Name="SuccessCheck" Data="M 0,7 L 6,13 L 18,1"
                                  Stroke="{DynamicResource Success}" StrokeThickness="3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  StrokeDashArray="9 9" StrokeDashOffset="9"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0"/>
                            <TextBlock x:Name="SameIcon" Style="{StaticResource Glyph}" Text="&#xE946;"
                                       FontSize="24" Foreground="{DynamicResource Warning}" Visibility="Collapsed"/>
                        </Grid>

                        <TextBlock x:Name="SuccessTitle" Style="{StaticResource SheetTitle}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="SuccessBody" Style="{StaticResource Centered}"
                                   Margin="10,5,10,0" MaxWidth="340"/>

                        <Button x:Name="DoneButton" Style="{StaticResource PrimaryButton}"
                                Content="{loc:Tr add.done}" Margin="0,18,0,2" Click="Close_Click"/>
                    </StackPanel>

                    <!-- ═══════════ 5 · Something went wrong ═══════════ -->
                    <StackPanel x:Name="ErrorPage" Visibility="Collapsed" Margin="0,6,0,0">
                        <Grid x:Name="ErrorBadge" Width="66" Height="66" HorizontalAlignment="Center">
                            <Ellipse Fill="{DynamicResource DangerSoft}"/>
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" FontSize="24"
                                       Foreground="{DynamicResource Danger}" Margin="0,-2,0,0"/>
                        </Grid>

                        <TextBlock Text="{loc:Tr add.errorTitle}" Style="{StaticResource SheetTitle}"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock x:Name="ErrorBody" Style="{StaticResource Centered}"
                                   Margin="10,5,10,0" MaxWidth="340"/>
                        <TextBlock x:Name="ErrorDetail" Style="{StaticResource Centered}"
                                   FontSize="{StaticResource FontCaption}" LineHeight="15"
                                   Foreground="{DynamicResource TextMuted}"
                                   Margin="10,8,10,0" MaxWidth="340" Visibility="Collapsed"/>

                        <Grid Margin="0,18,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Content="{loc:Tr add.close}"
                                    Click="Close_Click"/>
                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                    Content="{loc:Tr add.retry}" Click="Retry_Click"/>
                        </Grid>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
